{
  "name": "pi-remote-handoff",
  "version": "0.1.0",
  "description": "Hand a Pi conversation to a trusted SSH host and bring its result back",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "src",
    "remote",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "verify:e2e": "bash e2e/remote-handoff.e2e.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.9",
    "@earendil-works/pi-tui": "0.80.9",
    "@types/node": "^24.12.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
